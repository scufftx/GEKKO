FROM python:3.12-slim

WORKDIR /opt/gekko
COPY . .
# On the WSL kernel GEKKO defaults to running apm.exe (WSL_EXE=1); point it at the static Linux build
RUN chmod +x gekko/bin/apm* \
    && ln -sf apm gekko/bin/apm.exe \
    && pip install --no-cache-dir -e . jupyterlab matplotlib pandas scipy

RUN useradd -m -u 1000 gekko && mkdir -p /work && chown gekko /work
USER gekko
WORKDIR /work
EXPOSE 8888
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--ServerApp.token=", "--ServerApp.password=", "--ServerApp.root_dir=/work"]
